rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /warehouses/{warehouseId} {
      allow read: if signedIn()
        && request.auth.uid == resource.data.ownerUid;

      allow create: if signedIn()
        && request.resource.data.warehouseId == warehouseId
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.warehouseId == warehouseId
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /truckRegistrationRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requestId == requestId
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if signedIn()
        && resource.data.requestedByUid == request.auth.uid;

      allow update, delete: if false;
    }

    match /trucks/{truckId} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read, write: if false;
    }

    match /shipments/{shipmentId} {
      allow read, write: if false;
    }

    match /emailChangeChallenges/{documentId} {
      allow read, write: if false;
    }

    match /emailChangeRateLimits/{documentId} {
      allow read, write: if false;
    }
  }
}